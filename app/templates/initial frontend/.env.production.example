# Leave this unset in Vercel, or set it to /api/v1.
# Vercel proxies /api/v1/* to the Hugging Face backend, which avoids browser CORS.
VITE_API_BASE_URL=/api/v1

# Canonical wildcard used for isolated hospital and clinic workspaces. This one
# server-side value is validated and injected into the Vite build so browser and
# redirect code cannot disagree. Configure *.his.pro in Vercel DNS/TLS first.
# Do not use his-pro.vercel.app here: the project URL does not grant control of
# *.his-pro.vercel.app.
TENANT_BASE_DOMAIN=his.pro

# Generic product/login origin used for unknown or invalid workspace links.
PUBLIC_APP_ORIGIN=https://his-pro.vercel.app

# Server-side Vercel proxy settings. Both values are required.
# Use the staging Space URL in the staging Vercel project and the production
# Space URL only in the production Vercel project.
# Keep HF_TOKEN secret; never expose it with a VITE_ prefix.
HF_BACKEND_URL=https://your-environment-space.hf.space
HF_TOKEN=hf_your_private_space_access_token
