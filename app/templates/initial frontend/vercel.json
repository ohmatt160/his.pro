{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",

    "rewrites": [
        {
            "source": "/:rest*",
            "has": [{
                "type": "host",
                "value": "^(?!(?:admin|api|app|assets|auth|cdn|help|mail|static|status|support|www)\\.his\\.pro$)(?<legacyFacility>[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)\\.his\\.pro$"
            }],
            "destination": "/api/tenant-redirect?__hispro_facility=:legacyFacility&__hispro_kind=preserve&__hispro_rest=:rest*"
        },
        {
            "source": "/:facilitySlug/branches/:branchSlug/:rest*",
            "has": [{ "type": "host", "value": "^(?:his\\.pro|www\\.his\\.pro|his-pro(?:-v1-0)?\\.vercel\\.app)$" }],
            "destination": "/api/tenant-redirect?__hispro_facility=:facilitySlug&__hispro_kind=branch&__hispro_branch=:branchSlug&__hispro_rest=:rest*"
        },
        {
            "source": "/dashboard/:facilitySlug/:rest*",
            "has": [{ "type": "host", "value": "^(?:his\\.pro|www\\.his\\.pro|his-pro(?:-v1-0)?\\.vercel\\.app)$" }],
            "destination": "/api/tenant-redirect?__hispro_facility=:facilitySlug&__hispro_kind=dashboard&__hispro_rest=:rest*"
        },
        {
            "source": "/dashboard/:facilitySlug",
            "has": [{ "type": "host", "value": "^(?:his\\.pro|www\\.his\\.pro|his-pro(?:-v1-0)?\\.vercel\\.app)$" }],
            "destination": "/api/tenant-redirect?__hispro_facility=:facilitySlug&__hispro_kind=dashboard"
        },
        {
            "source": "/portal/:facilitySlug",
            "has": [{ "type": "host", "value": "^(?:his\\.pro|www\\.his\\.pro|his-pro(?:-v1-0)?\\.vercel\\.app)$" }],
            "destination": "/api/tenant-redirect?__hispro_facility=:facilitySlug&__hispro_kind=portal"
        },
        {
            "source": "/login/:facilitySlug",
            "has": [{ "type": "host", "value": "^(?:his\\.pro|www\\.his\\.pro|his-pro(?:-v1-0)?\\.vercel\\.app)$" }],
            "destination": "/api/tenant-redirect?__hispro_facility=:facilitySlug&__hispro_kind=login"
        },
        {
            "source": "/:facilitySlug/login",
            "has": [{ "type": "host", "value": "^(?:his\\.pro|www\\.his\\.pro|his-pro(?:-v1-0)?\\.vercel\\.app)$" }],
            "destination": "/api/tenant-redirect?__hispro_facility=:facilitySlug&__hispro_kind=login"
        },
        {
            "source": "/workspace-ready/:facilitySlug",
            "has": [{ "type": "host", "value": "^(?:his\\.pro|www\\.his\\.pro|his-pro(?:-v1-0)?\\.vercel\\.app)$" }],
            "destination": "/api/tenant-redirect?__hispro_facility=:facilitySlug&__hispro_kind=workspace-ready"
        },
        {
            "source": "/hospital/:facilitySlug",
            "has": [{ "type": "host", "value": "^(?:his\\.pro|www\\.his\\.pro|his-pro(?:-v1-0)?\\.vercel\\.app)$" }],
            "destination": "/api/tenant-redirect?__hispro_facility=:facilitySlug&__hispro_kind=hospital"
        },
        {
            "source": "/:facilitySlug((?!api$|assets$|dashboard$|dpa$|get-started$|hospital$|login$|portal$|privacy$|setting-up$|terms$|workspace-ready$)[a-z0-9][a-z0-9-]{0,99})",
            "has": [{ "type": "host", "value": "^(?:his\\.pro|www\\.his\\.pro|his-pro(?:-v1-0)?\\.vercel\\.app)$" }],
            "destination": "/api/tenant-redirect?__hispro_facility=:facilitySlug&__hispro_kind=login"
        },
        { "source": "/api/v1/:path*", "destination": "/api/proxy?path=:path*" },
        { "source": "/((?!api/).*)", "destination": "/index.html" }
    ],

    "headers": [{
            "source": "/assets/(.*)",
            "headers": [{
                "key": "Cache-Control",
                "value": "public, max-age=31536000, immutable"
            }]
        },
        {
            "source": "/(.*)",
            "headers": [{
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=()"
                }
            ]
        }
    ]
}
