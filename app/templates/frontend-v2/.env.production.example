# Leave this unset in Vercel, or set it to /api/v1.
# Vercel proxies /api/v1/* to the Hugging Face backend, which avoids browser CORS.
VITE_API_BASE_URL=/api/v1

# Optional direct backend WebSocket base. Leave unset when the backend has no
# public WebSocket endpoint; the app then relies on HTTP without retry loops.
# Never point this to the Vercel /api proxy (serverless HTTP cannot proxy WS).
# VITE_REALTIME_WS_URL=wss://your-backend-host/api/v1

# Optional canonical wildcard for hospital and clinic subdomains. Leave this
# unset until you own a domain and have configured its wildcard DNS/TLS in
# Vercel. Without it, workspaces use paths such as /sunrise-medical/login.
# Never use his-pro.vercel.app here: the project URL does not grant control of
# *.his-pro.vercel.app.
# TENANT_BASE_DOMAIN=yourdomain.com

# Optional generic product/login origin. When omitted, Vercel's trusted system
# deployment hostname is used; the browser also falls back to its current origin.
# PUBLIC_APP_ORIGIN=https://your-project.vercel.app

# Server-side Vercel proxy settings. Both values are required.
# Use the staging Space URL in the staging Vercel project and the production
# Space URL only in the production Vercel project.
# Keep HF_TOKEN secret; never expose it with a VITE_ prefix.
HF_BACKEND_URL=https://your-environment-space.hf.space
HF_TOKEN=hf_your_private_space_access_token
