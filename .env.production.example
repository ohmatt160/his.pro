# Backend production environment. Store real values in the deployment secret
# manager; never commit a populated production file.
APP_ENV=production
PORT=7860
WEB_CONCURRENCY=2

# Generate independent random values of at least 32 characters.
JWT_SECRET_KEY=replace-with-a-long-random-secret
CSRF_SECRET_KEY=replace-with-a-different-long-random-secret

# Vercel frontend URL. Include any custom domains here too.
FRONTEND_URL=https://his-pro-v1-0.vercel.app
ALLOWED_ORIGINS=https://his-pro-v1-0.vercel.app,https://his-pro.vercel.app
COOKIE_SECURE=true
# Add preview origins explicitly. Do not use a broad credentialed origin regex.

# Docker Compose database values. URL-encode special characters when placing
# the password inside DATABASE_URL.
POSTGRES_USER=hispro
POSTGRES_PASSWORD=replace-with-a-long-database-password
POSTGRES_DB=hispro
DATABASE_URL=postgresql+psycopg2://hispro:replace-password@db:5432/hispro
ALLOW_SQLITE_IN_PRODUCTION=false

REDIS_PASSWORD=replace-with-a-long-redis-password
REDIS_URL=redis://:replace-with-url-encoded-password@redis:6379/0
REALTIME_REDIS_REQUIRED=true
ALLOW_IN_MEMORY_COORDINATION=false
BACKGROUND_JOBS_INLINE=false
BACKGROUND_JOB_WORKER_ENABLED=true
# Single-container staging platforms may opt in to these. Keep both false when
# migrations and workers run as separate services, as in docker-compose.yml.
RUN_MIGRATIONS_ON_START=false
BUNDLED_BACKGROUND_WORKER=false
# MAIL_SERVER=
# MAIL_PORT=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=

MAX_UPLOAD_BYTES=5242880
MAX_CHAT_FILE_BYTES=10485760
MAX_RECEIPT_BYTES=5242880
FILE_UPLOAD_DIR=/data/private/files
CHAT_UPLOAD_DIR=/data/private/chat
RECEIPT_UPLOAD_DIR=/data/private/receipts
MALWARE_SCAN_REQUIRED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Keep public signup off until owner email verification is enforced. Use this
# server-side token for invitation-only onboarding during the pilot.
PUBLIC_SIGNUP_ENABLED=false
ONBOARDING_TOKEN=replace-with-a-long-random-onboarding-token
METRICS_PUBLIC=false
METRICS_TOKEN=replace-with-a-long-random-token

# Optional OhmattOS platform integration. Enable only after the real HIS Pro
# service public key and every real facility UUID are registered in OhmattOS.
OHMATTOS_ENABLED=false
OHMATTOS_URL=https://ohmattos.fly.dev
OHMATTOS_TOKEN_URL=https://ohmattos.fly.dev/api/v1/auth/token
OHMATTOS_CLIENT_ID=hispro-production
# Mount this file from a secret manager. Never commit the private key.
OHMATTOS_CLIENT_PRIVATE_KEY_FILE=/run/secrets/hispro-ohmattos-private-key.pem
OHMATTOS_CLIENT_KEY_ID=replace-with-registered-key-id
OHMATTOS_CLIENT_SIGNING_ALG=RS256
OHMATTOS_TOKEN_AUDIENCE=https://ohmattos.fly.dev/api/v1/auth/token
OHMATTOS_API_AUDIENCE=ohmattos-api
OHMATTOS_MAX_TOKEN_TTL_SECONDS=300
OHMATTOS_TOKEN_REFRESH_SKEW_SECONDS=30
OHMATTOS_TOKEN_CACHE_SIZE=2048
OHMATTOS_TIMEOUT_SECONDS=5
OHMATTOS_TRUST_ENV_PROXY=false
# Optional sender-constrained transport. Configure both or neither.
# OHMATTOS_MTLS_CERT_FILE=/run/secrets/hispro-ohmattos-client.crt
# OHMATTOS_MTLS_KEY_FILE=/run/secrets/hispro-ohmattos-client.key
# OHMATTOS_CA_BUNDLE=/run/secrets/ohmattos-ca.pem
OHMATTOS_JOBS_ENABLED=false
OHMATTOS_NOTIFICATIONS_ENABLED=false
# Explicitly opt in to both external channels when notifications are enabled.
HISPRO_PATIENT_NOTIFICATION_CHANNELS=PORTAL,SMS,EMAIL
OHMATTOS_ANALYTICS_ENABLED=false
OHMATTOS_LOGS_ENABLED=false
OHMATTOS_STORAGE_ENABLED=false
INTEGRATION_OUTBOX_BATCH_SIZE=25
INTEGRATION_OUTBOX_LEASE_SECONDS=120
INTEGRATION_OUTBOX_POLL_SECONDS=2
